{
  "multipart": [
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_post_ends"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_post"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_cap"
      },
      "when": {
        "east": "false",
        "north": "true",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_cap",
        "y": 90
      },
      "when": {
        "east": "true",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_cap_alt"
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "true",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_cap_alt",
        "y": 90
      },
      "when": {
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_side_alt"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "rauk:block/wrought_iron_railing_side_alt",
        "y": 90
      },
      "when": {
        "west": "true"
      }
    }
  ]
}